<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Bai Jamjuree',sans-serif;background:#fff;color:#000;padding:20px 28px;line-height:1.5;max-width:100%;margin:0 auto}

.matrix{
  display:grid;
  grid-template-columns:26px 42px 1fr 1fr;
  grid-template-rows:auto auto 1fr 1fr;
  grid-template-areas:
    ".  .   ax   ax"
    ".  .   ch1  ch2"
    "ay rh1 c0   c1"
    "ay rh2 c2   c3";
  gap:10px;
}

.axis-x{grid-area:ax;text-align:center;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#0A3D4F}
.axis-y{grid-area:ay;display:flex;align-items:center;justify-content:center}
.axis-y span{writing-mode:vertical-rl;transform:rotate(180deg);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#0A3D4F;white-space:nowrap}

.col-h{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#999;text-align:center;align-self:end}
.row-h{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#999;display:flex;align-items:center;justify-content:flex-end}

.cell{font-family:inherit;background:#f4f4f3;border:2px solid #ecedea;border-radius:10px;padding:14px 16px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:8px;transition:.18s}
.cell:hover{border-color:var(--a)}
.cell.active{background:var(--a);border-color:var(--a)}
.fig{height:104px;display:flex;align-items:flex-end}
.fig img{max-height:104px;width:auto;display:block}
.cname{font-size:18px;font-weight:700;color:#0A3D4F}
.cell.active .cname{color:#fff}
.cell.active .fig img{filter:brightness(0) invert(1)}

.panel{margin-top:20px;background:#f7f7f5;border-left:4px solid #ecedea;border-radius:0 10px 10px 0;padding:16px 22px;min-height:120px}
.panel .empty{font-size:18px;font-weight:500;color:#999}
.pname{font-size:28px;font-weight:700;color:#111}
.meta{font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;margin-top:2px}
.meta .dot{opacity:.5;margin:0 6px}
.blabel{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#999;margin-top:14px}
.behavior{font-size:18px;font-weight:500;margin-top:2px}
</style>
</head>
<body>

<div class="matrix">
  <div class="axis-x">Chose it?</div>
  <div class="col-h" style="grid-area:ch1">No</div>
  <div class="col-h" style="grid-area:ch2">Yes</div>

  <div class="axis-y"><span>Wants it?</span></div>

  <div class="row-h" style="grid-area:rh1">Yes</div>
  <div class="row-h" style="grid-area:rh2">No</div>

  <button class="cell" style="grid-area:c0;--a:#F59E0B;--t:#FEF6E7" data-id="0" aria-label="Walker">
    <div class="fig"><img src="data:image/png;base64," alt="Walker"></div>
    <div class="cname">Walker</div>
  </button>
  <button class="cell" style="grid-area:c1;--a:#10B981;--t:#EAF9F3" data-id="1" aria-label="Runner">
    <div class="fig"><img src="data:image/png;base64," alt="Runner"></div>
    <div class="cname">Runner</div>
  </button>
  <button class="cell" style="grid-area:c2;--a:#DC2626;--t:#FDEDED" data-id="2" aria-label="Resister">
    <div class="fig"><img src="data:image/png;base64," alt="Resister"></div>
    <div class="cname">Resister</div>
  </button>
  <button class="cell" style="grid-area:c3;--a:#50D0ED;--t:#EAFAFE" data-id="3" aria-label="Trudger">
    <div class="fig"><img src="data:image/png;base64," alt="Trudger"></div>
    <div class="cname">Trudger</div>
  </button>
</div>

<div class="panel" id="panel">
  <p class="empty">Click a figure to see their typical behavior.</p>
</div>

<script>
var D = [{"n": "Walker", "c": "No", "w": "Yes", "b": "Open but cautious. Asks questions before engaging.", "a": "#F59E0B", "t": "#FEF6E7", "x": "#B45309"}, {"n": "Runner", "c": "Yes", "w": "Yes", "b": "Enthusiastic, leads others, and sometimes pushes them to move faster.", "a": "#10B981", "t": "#EAF9F3", "x": "#059669"}, {"n": "Resister", "c": "No", "w": "No", "b": "Argues, withdraws, or disengages.", "a": "#DC2626", "t": "#FDEDED", "x": "#DC2626"}, {"n": "Trudger", "c": "Yes", "w": "No", "b": "Moves slowly and without enthusiasm. Formally agrees but does not act.", "a": "#50D0ED", "t": "#EAFAFE", "x": "#0E7C99"}];
var cells = document.querySelectorAll('.cell');
var panel = document.getElementById('panel');
cells.forEach(function(c){
  c.addEventListener('click', function(){
    cells.forEach(function(x){x.classList.remove('active')});
    c.classList.add('active');
    var d = D[+c.dataset.id];
    panel.style.background = d.t;
    panel.style.borderLeftColor = d.a;
    panel.innerHTML =
      '<div class="pname">' + d.n + '</div>' +
      '<div class="meta" style="color:' + d.x + '">Chose it: ' + d.c +
        '<span class="dot">&middot;</span>Wants it: ' + d.w + '</div>' +
      '<div class="blabel">Typical behavior</div>' +
      '<div class="behavior">' + d.b + '</div>';
  });
});
</script>
</body>
</html>
